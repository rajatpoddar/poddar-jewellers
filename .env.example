# Local development.
#
# If you have Docker: `docker compose -f docker-compose.dev.yml up -d` and use
#   postgresql://poddar:poddar@localhost:5544/poddar_jewellers?schema=public
# If you already run Postgres locally, create the role and database once:
#   createuser -P poddar && createdb -O poddar poddar_jewellers
# and use port 5432 as below.
DATABASE_URL="postgresql://poddar:poddar@localhost:5432/poddar_jewellers?schema=public"

# 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-32-byte-random-string"

# Used once, by `npm run db:seed`, to create the first admin user.
SEED_ADMIN_USERNAME="rajat"
SEED_ADMIN_PASSWORD="change-me-on-first-login"

UPLOAD_DIR="./public/uploads"
