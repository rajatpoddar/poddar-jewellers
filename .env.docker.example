# Production environment, for Coolify or `docker compose --env-file`.
POSTGRES_USER=poddar
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=poddar_jewellers

SESSION_SECRET=               # 32+ chars: openssl rand -base64 32

# A free host port on the NAS. Check first: sudo docker ps
APP_PORT=3210

# Used once by the `migrate` service. Change the password after first login.
SEED_ADMIN_USERNAME=rajat
SEED_ADMIN_PASSWORD=
